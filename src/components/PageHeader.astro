---
interface Props {
  heading: string;
  intro?: string | undefined;
  eyebrow?: string | undefined;
}
const { heading, intro, eyebrow } = Astro.props;
---

<section class="page-header">
  <div class="container">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{heading}</h1>
    {intro && <p class="page-header__intro">{intro}</p>}
    <slot />
  </div>
</section>

<style>
  .page-header {
    padding-block: var(--space-7) var(--space-6);
    background:
      radial-gradient(50rem 20rem at 90% 0%, var(--color-accent-soft), transparent 70%),
      var(--color-bg);
    border-bottom: var(--border);
  }

  .page-header__intro {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 40rem;
    margin: 0;
  }
</style>
