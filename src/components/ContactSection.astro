---
import { site } from '../lib/data';

interface Props {
  headingLevel?: 'h2' | 'h3';
}
const { headingLevel: Heading = 'h3' } = Astro.props;
const { address, contact } = site;
const addressLines = [address.street, [address.city, address.region, address.postalCode].filter(Boolean).join(', '), address.country].filter(Boolean);
const whatsappDigits = contact.whatsapp.replace(/\D/g, '');
---

<div class="contact card">
  <Heading class="contact__title">Visit and contact</Heading>
  <dl>
    <div>
      <dt>Address</dt>
      <dd>
        {address.placeholder && <span class="placeholder-note">Placeholder address</span>}
        <address>
          {addressLines.map((line) => <span>{line}</span>)}
        </address>
        {address.mapUrl && (
          <a href={address.mapUrl} rel="noopener" target="_blank">
            Open in Google Maps<span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        )}
      </dd>
    </div>
    {
      contact.phone && (
        <div>
          <dt>{contact.phoneLabel}</dt>
          <dd>
            <a href={`tel:${contact.phone.replace(/[^\d+]/g, '')}`}>{contact.phone}</a>
          </dd>
        </div>
      )
    }
    {
      whatsappDigits && (
        <div>
          <dt>WhatsApp</dt>
          <dd>
            <a href={`https://wa.me/${whatsappDigits}`} rel="noopener" target="_blank">
              {contact.whatsapp}
            </a>
          </dd>
        </div>
      )
    }
    {
      contact.email && (
        <div>
          <dt>Email</dt>
          <dd>
            <a href={`mailto:${contact.email}`}>{contact.email}</a>
          </dd>
        </div>
      )
    }
  </dl>
</div>

<style>
  .contact {
    padding: var(--space-5);
  }

  .contact__title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }

  dl {
    margin: 0;
    display: grid;
    gap: var(--space-4);
  }

  dt {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  dd {
    margin: var(--space-1) 0 0;
  }

  address {
    font-style: normal;
    display: grid;
    margin: var(--space-1) 0;
  }

  a {
    font-weight: 600;
    overflow-wrap: anywhere;
  }
</style>
