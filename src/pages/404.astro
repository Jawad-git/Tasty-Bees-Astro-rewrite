---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';
---

<BaseLayout title="Page not found" description="Sorry, we couldn't find that page. Head back to the TastyBees homepage or browse our full menu.">
  <section class="section">
    <div class="container" style="text-align: center; max-width: 36rem;">
      <span class="eyebrow">404</span>
      <h1>This page has flown away</h1>
      <p class="muted">The page you're looking for doesn't exist or has moved.</p>
      <p><a class="btn btn--primary" href={url('/')}>Back to home</a> <a class="btn btn--secondary" href={url('/menu/')}>See the menu</a></p>
    </div>
  </section>
</BaseLayout>
